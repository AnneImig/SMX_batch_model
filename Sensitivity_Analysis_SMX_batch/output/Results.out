	RATES
	    Som
	start
	01 rate		= parm(1)*m
	10 moles 	= rate *time
	15 put(rate,01)
	20 SAVE moles
	end
	    Doc_r
	start
	 1 rate       = parm(1)*tot("Docr")
	10 moles      = rate *time
	15 put(rate,02)
	20 SAVE moles
	end
	    Nitrification_NO2
	start
	60 rate		  = (parm(1)*mol("O2")*mol("Amonia"))
	65 put(rate,10)
	70 moles      = rate*time
	80 SAVE moles
	end
	    Nitrification_NO3
	start
	60 rate		  = (parm(1)*mol("O2")*tot("Nit"))
	65 put(rate,11)
	70 moles      = rate*time
	80 SAVE moles
	end
	    Doc_Degradation_OX
	start
	01 if (m <= 0) then goto 50
	30 rate_O2    = (parm(1)*mol("O2")*tot("Doc"))
	35 put(rate_O2, 12)
	40 moles 	  = (rate_O2) *time
	50 SAVE moles
	end
	Smx_DES_O
	start
	10 mSmx  	    = tot("Smx")
	35 mDoc        = tot('Doc')
	52  rate_SmxDes  = (parm(1)*mSmx* mDoc )
	55 put(rate_SmxDes, 19)
	60 moles 	  = (rate_SmxDes) *time
	70 SAVE moles
	end
	Smx_DES_N
	start
	10 rate= parm(1)* mol("H(Nit)")*tot("Doc")*tot("Smx")
	11 put(rate, 191)
	20 moles 	  = rate *time
	70 SAVE moles
	end
	DES_Smx
